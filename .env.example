# ForgeMind Environment Variables
# Copy to .env and fill in: cp .env.example .env

# === Core ===
FORGEMIND_ENV=dev  # dev / staging / prod
FORGEMIND_MODE=server  # server / desktop / cli
FORGEMIND_LOG_LEVEL=INFO
FORGEMIND_LOG_FORMAT=json  # json / text
FORGEMIND_DATA_DIR=./data
FORGEMIND_VERSION=2026.09.0

# === API ===
FORGEMIND_API_HOST=0.0.0.0
FORGEMIND_API_PORT=8000
FORGEMIND_API_WORKERS=4
FORGEMIND_API_SECRET_KEY=change-me-in-production-32-chars-min
FORGEMIND_API_JWT_ALG=HS256
FORGEMIND_API_JWT_EXPIRE_HOURS=24
FORGEMIND_API_CORS_ORIGINS=http://localhost:3000,tauri://localhost

# === PostgreSQL (Patroni) ===
FORGEMIND_PG_HOST=localhost
FORGEMIND_PG_PORT=5432
FORGEMIND_PG_USER=forgemind
FORGEMIND_PG_PASSWORD=forgemind
FORGEMIND_PG_DATABASE=forgemind
FORGEMIND_PG_POOL_SIZE=10
FORGEMIND_PG_MAX_OVERFLOW=20

# === ClickHouse ===
FORGEMIND_CH_HOST=localhost
FORGEMIND_CH_PORT=9000
FORGEMIND_CH_HTTP_PORT=8123
FORGEMIND_CH_USER=forgemind
FORGEMIND_CH_PASSWORD=forgemind
FORGEMIND_CH_DATABASE=forgemind

# === Redis / Valkey ===
FORGEMIND_REDIS_HOST=localhost
FORGEMIND_REDIS_PORT=6379
FORGEMIND_REDIS_DB=0
FORGEMIND_REDIS_PASSWORD=

# === NATS JetStream ===
FORGEMIND_NATS_URL=nats://localhost:4222
FORGEMIND_NATS_CLUSTER_NAME=forgemind-cluster

# === DuckDB (本地) ===
FORGEMIND_DUCKDB_PATH=./data/duckdb/main.db

# === MinIO ===
FORGEMIND_MINIO_ENDPOINT=localhost:9000
FORGEMIND_MINIO_ACCESS_KEY=forgemind
FORGEMIND_MINIO_SECRET_KEY=forgemind
FORGEMIND_MINIO_BUCKET=forgemind

# === Vault ===
FORGEMIND_VAULT_ADDR=http://localhost:8200
FORGEMIND_VAULT_TOKEN=dev-only-token

# === LLM Providers ===
FORGEMIND_OPENAI_API_KEY=sk-your-key-here
FORGEMIND_OPENAI_BASE_URL=https://api.openai.com/v1
FORGEMIND_ANTHROPIC_API_KEY=sk-ant-your-key-here
FORGEMIND_QWEN_API_KEY=your-qwen-key

# === Brokers ===
# ForgeMind v1.0+ 完全解耦券商 SDK
# 用户自己用 vnpy / nautilus_trader / 自己 broker SDK 执行信号
# 见 §24 L7 信号输出层

# === Data sources ===
FORGEMIND_TUSHARE_TOKEN=your-tushare-token

# === Risk ===
FORGEMIND_RISK_DAILY_LOSS_LIMIT_PCT=-0.05
FORGEMIND_RISK_MAX_POSITION_PCT=0.20
FORGEMIND_RISK_MAX_DAILY_TRADES=1000
FORGEMIND_RISK_CANCEL_RATIO_LIMIT=0.70

# === Feature Store ===
FORGEMIND_FEATURE_IC_ALERT_THRESHOLD=0.02
FORGEMIND_FEATURE_OFFLINE_ONLINE_PARITY_THRESHOLD=0.01

# === Observability ===
FORGEMIND_OTEL_ENABLED=true
FORGEMIND_OTEL_ENDPOINT=http://localhost:4317
FORGEMIND_PROMETHEUS_PORT=9090

# === Desktop (Tauri sidecar) ===
FORGEMIND_DESKTOP_API_PORT=8008